<UserControl x:Class="CleanSweep.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="980">
    <UserControl.Resources>
        <Style x:Key="HeroButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,22">
            <!-- Hero -->
            <Border CornerRadius="20" Padding="30,28" SnapsToDevicePixels="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#103B2D" Offset="0" />
                        <GradientStop Color="#176A4E" Offset="0.56" />
                        <GradientStop Color="#1C8B62" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="238" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <Border Background="#1FFFFFFF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="本地 · 安全 · 可追溯" FontSize="10.5" Foreground="#D8F4E7" />
                        </Border>
                        <TextBlock Text="让 Windows&#x0a;轻一点。" Foreground="White" FontSize="34"
                                   FontWeight="SemiBold" LineHeight="44" Margin="0,14,0,0" />
                        <TextBlock Text="只清理有证据的垃圾。每一项都能预览、能解释、能追溯；扫描阶段绝不修改文件。"
                                   Foreground="#C9E9DA" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                                   MaxWidth="500" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Style="{StaticResource HeroButton}" Command="{Binding ScanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ScanButtonText}" Margin="7,0,0,0"
                                               Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding LastScanText}" Foreground="#A9D4C0" FontSize="10.5"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="214" Height="214" CornerRadius="107"
                            Background="#12FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="本次发现" Foreground="#A9D4C0" FontSize="10.5"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding HeroMetricText}" Foreground="White" FontSize="30"
                                       FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding HeroSubMetric}" Foreground="#D8F4E7" FontSize="10.5"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                            <Border Width="34" Height="1" Background="#40FFFFFF" Margin="0,12,0,12" />
                            <TextBlock Text="{Binding HeroHint}" Foreground="#A9D4C0" FontSize="9.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Elevation hint -->
            <Border Background="{StaticResource AmberSoftBrush}" BorderBrush="#F0D7AB" BorderThickness="1"
                    CornerRadius="12" Padding="14,11" Margin="0,12,0,0"
                    Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="当前是标准权限。Windows 临时目录、更新缓存和系统冗余会显示为“需管理员”，不能勾选清理。"
                               FontSize="11.5" Foreground="#7B5A22" TextWrapping="Wrap" Margin="9,0,12,0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding ElevateCommand}"
                            Content="以管理员身份重启" Foreground="{StaticResource AmberBrush}" />
                </Grid>
            </Border>

            <!-- Categories -->
            <Grid Margin="0,24,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="清理范围" Style="{StaticResource H3}" />
                    <TextBlock Text="四类规则分开呈现，你可以逐项确认后再清理。"
                               Style="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FoundSummaryText}" Style="{StaticResource Caption}"
                           VerticalAlignment="Bottom" Margin="0,0,2,1" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Margin" Value="0,0,12,12" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Command="{Binding DataContext.NavigateCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Key}">
                            <Grid Margin="18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="13"
                                        Background="{Binding SoftAccent, Converter={StaticResource HexBrush}}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="18" Foreground="{Binding Accent, Converter={StaticResource HexBrush}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,1,10,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Background="{Binding SoftAccent, Converter={StaticResource HexBrush}}"
                                                Visibility="{Binding SelectedCount, Converter={StaticResource ZeroToVisibility}, ConverterParameter=invert}">
                                            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource ChipText}"
                                                       Foreground="{Binding Accent, Converter={StaticResource HexBrush}}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{Binding Accent, Converter={StaticResource HexBrush}}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="查看 ›" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Scan notes -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,2,0,12"
                    Visibility="{Binding HasScanNotes, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="扫描备注" Style="{StaticResource H3}" Margin="7,0,0,0" FontSize="13" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ScanNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Principles -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="为什么可以放心" Style="{StaticResource H3}" />
                    <TextBlock Text="这个工具不追求“一键清空”，而是把每一个删除决定摊开给你看。"
                               Style="{StaticResource Muted}" Margin="0,4,0,14" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="01" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="#B7CCC2" />
                            <TextBlock Text="先扫描，后清理" Style="{StaticResource Body}" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="扫描只读；不会在后台自动删除任何文件。" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="02" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="#B7CCC2" />
                            <TextBlock Text="每项都有依据" Style="{StaticResource Body}" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="时间阈值、路径、哈希或注册表证据都会写清楚。" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="03" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="#B7CCC2" />
                            <TextBlock Text="删除可追溯" Style="{StaticResource Body}" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="完整日志留存；注册表先备份，重复文件进回收站。" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
