<UserControl x:Class="CleanSweep.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,22">
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource GreenSoftBrush}">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource GreenDarkBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="每次清理都有完整记录" Style="{StaticResource H3}" />
                        <TextBlock Text="日志包含每个路径、删除依据、结果和注册表备份位置。默认保留最近 30 条。"
                                   Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallButton}" Content="刷新" Command="{Binding RefreshLogsCommand}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource SmallButton}" Content="打开日志目录"
                                Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" CornerRadius="2" Background="#A9D4C0" VerticalAlignment="Stretch"
                                        Margin="0,2,14,2" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource H3}" FontSize="13" />
                                        <Border Style="{StaticResource ChipBorder}" Margin="9,0,0,0"
                                                Background="{StaticResource GreenSoftBrush}">
                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource GreenDarkBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="直接释放 " Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding FreedText}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Ink2Brush}" FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  回收站 " Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding RecycledText}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Ink2Brush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SmallButton}" Content="打开报告"
                                            Command="{Binding DataContext.OpenLogCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="所在目录"
                                            Command="{Binding DataContext.OpenLogFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="40,45"
                    Visibility="{Binding HasLogs, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource GreenPaleBrush}">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="还没有清理记录" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="完成一次清理后，这里会显示释放空间、处理数量和报告路径。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12,9" Margin="0,2,0,0">
                <TextBlock Text="{Binding LogsDirectory}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
