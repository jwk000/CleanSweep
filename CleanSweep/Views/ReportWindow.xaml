<Window x:Class="CleanSweep.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="清理结果"
        Width="780" Height="800" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="#F7FAF8" CornerRadius="18" BorderBrush="#DFE9E3" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#17342A" BlurRadius="32" ShadowDepth="8" Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="18,18,0,0" Padding="26,22"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource GreenSoftBrush}">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{StaticResource GreenDarkBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource WindowButton}" Width="34" Height="34"
                            Click="Close_Click" VerticalAlignment="Top">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,20,26,0">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Padding="15,13" Margin="0,0,9,0">
                            <StackPanel>
                                <TextBlock Text="直接释放" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding FreedText}" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{StaticResource GreenDarkBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="15,13" Margin="0,0,9,0">
                            <StackPanel>
                                <TextBlock Text="移入回收站" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding RecycledText}" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{StaticResource BlueBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="15,13">
                            <StackPanel>
                                <TextBlock Text="处理结果" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ResultText}" FontSize="23" FontWeight="SemiBold"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="{StaticResource AmberSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,14,0,0"
                            Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FailureText}" Style="{StaticResource Caption}" Foreground="#7B5A22"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,20,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="处理明细" Style="{StaticResource H3}" />
                        <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                             MaxHeight="330" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="13,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top"
                                                 Margin="0,6,0,0" />
                                        <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}"
                                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding Basis}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" MaxHeight="36" />
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource RedBrush}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
                                            <TextBlock Text="{Binding BackupText}" Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource GreenDarkBrush}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding BackupText, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                                       Foreground="{Binding StatusBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="0,2,0,8"
                               Visibility="{Binding MoreText, Converter={StaticResource StringToVisibility}}" />

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12,10" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="完整日志" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource Mono}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}" />
                            <TextBlock Text="日志中包含每个路径、删除依据、执行结果和注册表备份位置。"
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" CornerRadius="0,0,18,18" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="26,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="打开完整日志" Click="OpenLog_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="打开备份目录" Click="OpenBackup_Click"
                                Margin="4,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="完成" Click="Close_Click"
                            Height="38" MinWidth="98" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
