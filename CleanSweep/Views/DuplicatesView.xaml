<UserControl x:Class="CleanSweep.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,22">
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource BlueSoftBrush}">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="内容比对结果" Style="{StaticResource H3}" />
                        <TextBlock Text="同大小 → 前缀哈希 → SHA-256 全量比对；内容完全一致才会归为一组。"
                                   Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentCategorySummary.SizeText}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CurrentCategorySummary.CountText}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource BlueSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="每组默认保留修改时间最早的一份，其余移入回收站。移入回收站不会立即释放空间；清空回收站后才真正释放。"
                               FontSize="11.5" Foreground="#315B9A" TextWrapping="Wrap" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,11">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"
                                              Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource H3}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                            <Border Style="{StaticResource ChipBorder}" Margin="8,0,0,0"
                                                    Background="{StaticResource BlueSoftBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource ChipText}"
                                                           Foreground="{StaticResource BlueBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding HashText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ReclaimableText}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="可释放" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Margin="28,12,0,0"
                                        Padding="8,4">
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <RadioButton IsChecked="{Binding IsKeep, Mode=OneWay}"
                                                                 GroupName="{Binding GroupId}"
                                                                 Command="{Binding DataContext.KeepFileCommand,
                                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}"
                                                                 Content="保留" VerticalAlignment="Top" Margin="2,2,0,0" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Body}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" />
                                                        <TextBlock Text="{Binding AgeText}" Style="{StaticResource Caption}"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Border x:Name="StatePill" Background="#EDF2EF" CornerRadius="5"
                                                                Padding="7,3" VerticalAlignment="Center">
                                                            <TextBlock x:Name="StateText" Text="跳过" FontSize="9.5"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="StatePill" Property="Background" Value="#FDEEEE" />
                                                        <Setter TargetName="StateText" Property="Text" Value="将删除" />
                                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource RedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                                        <Setter TargetName="StatePill" Property="Background" Value="{StaticResource GreenSoftBrush}" />
                                                        <Setter TargetName="StateText" Property="Text" Value="保留副本" />
                                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Margin="28,10,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <Run Text="保留：" />
                                    <Run Text="{Binding KeepPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="40,45" Margin="0,0,0,10"
                    Visibility="{Binding HasDuplicateFindings, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource BlueSoftBrush}">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="没有发现重复文件" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="默认扫描桌面、文档、图片、音乐、视频和下载文件夹；可提高最小文件大小以减少误报。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"
                               TextAlignment="Center" MaxWidth="520" />
                    <Button Style="{StaticResource SecondaryButton}" Content="重新扫描" Command="{Binding ScanCommand}"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Height="34" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
