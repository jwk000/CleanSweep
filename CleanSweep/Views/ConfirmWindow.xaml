<Window x:Class="CleanSweep.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="确认清理"
        Width="570" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="18" BorderBrush="#DFE9E3" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#17342A" BlurRadius="30" ShadowDepth="8" Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,22,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="确认清理" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="请核对将要处理的项目。确认后才会开始删除。" Style="{StaticResource Muted}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowButton}" Width="34" Height="34"
                        Click="Cancel_Click" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,18,24,0"
                          MaxHeight="470">
                <StackPanel>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ItemCountText}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MethodSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource GreenDarkBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding RecycleText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="分类明细" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{Binding Accent, Converter={StaticResource HexBrush}}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Body}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F7FAF8" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="删除方式" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                            <TextBlock Text="· 临时文件、浏览器缓存、系统冗余：永久删除。" Style="{StaticResource Caption}" />
                            <TextBlock Text="· 失效快捷方式、重复文件：移至回收站，可手动还原。" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <TextBlock Text="· 注册表残留：先导出 .reg 备份，再删除；可在备份目录中双击恢复。" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <TextBlock Text="· 回收站：清空后不可恢复。" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource RedSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                            Visibility="{Binding HasHighRisk, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="高风险项目" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource RedBrush}" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding HighRiskText}" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                       Foreground="#8E3B3B" TextWrapping="Wrap" />
                            <CheckBox x:Name="RiskCheck" Content="我已知晓这些项目删除后不可恢复，仍要继续"
                                      Margin="0,9,0,0" Checked="RiskCheck_Changed" Unchecked="RiskCheck_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,18,0,0" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="未勾选的项目不会被处理。" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="Cancel_Click"
                                Height="38" MinWidth="82" Margin="0,0,9,0" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="开始清理"
                                Click="Confirm_Click" Height="38" MinWidth="112" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
