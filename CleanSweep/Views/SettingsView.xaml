<UserControl x:Class="CleanSweep.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,22" MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="扫描规则" Style="{StaticResource H3}" />
                    <TextBlock Text="阈值只影响下一次扫描，不会修改已经发现的结果。"
                               Style="{StaticResource Muted}" Margin="0,3,0,16" />

                    <TextBlock Text="临时文件保留时间" Style="{StaticResource SectionLabel}" />
                    <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding TempAgeOptions}"
                             SelectedValue="{Binding TempAgeHours, Mode=TwoWay}" SelectedValuePath="Value">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="只删除最后修改时间早于该阈值的临时文件；正在使用、符号链接和系统保护路径不会被触碰。"
                               Style="{StaticResource Caption}" Margin="0,7,0,0" />

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Text="重复文件最小大小" Style="{StaticResource SectionLabel}" />
                    <ListBox Style="{StaticResource ChipListBox}" ItemsSource="{Binding DuplicateSizeOptions}"
                             SelectedValue="{Binding DuplicateMinSizeKb, Mode=TwoWay}" SelectedValuePath="Value">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="小于阈值的文件不参与重复扫描，避免大量小文件拖慢速度。所有候选都会做 SHA-256 全量校验。"
                               Style="{StaticResource Caption}" Margin="0,7,0,0" />

                    <Border Style="{StaticResource Divider}" />

                    <CheckBox IsChecked="{Binding IncludeBrowserCache, Mode=TwoWay}" Content="扫描浏览器缓存（Chrome / Edge / Brave / Firefox）" />
                    <TextBlock Text="浏览器正在运行时自动跳过，避免读取或删除正在使用的缓存文件。"
                               Style="{StaticResource Caption}" Margin="27,4,0,12" />
                    <CheckBox IsChecked="{Binding IncludeCrashDumps, Mode=TwoWay}" Content="扫描应用崩溃转储和系统小型转储" />
                    <TextBlock Text="转储文件可能用于故障排查，默认不勾选清理，只在你主动选择时处理。"
                               Style="{StaticResource Caption}" Margin="27,4,0,12" />
                    <CheckBox IsChecked="{Binding IncludeSystemCache, Mode=TwoWay}" Content="扫描 Windows 升级残留和回收站" />
                    <TextBlock Text="升级残留属于高风险项目，始终需要手动勾选并二次确认；回收站默认不勾选。"
                               Style="{StaticResource Caption}" Margin="27,4,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"
                                Content="保存设置" Height="38" MinWidth="112" />
                        <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="数据与备份" Style="{StaticResource H3}" />
                    <TextBlock Text="绿色单文件运行；日志、设置和注册表备份默认保存在当前用户的本地数据目录。"
                               Style="{StaticResource Muted}" Margin="0,3,0,14" />
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="打开数据目录"
                                Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SmallButton}" Content="打开备份目录"
                                Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SmallButton}" Content="打开日志目录"
                                Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="如需完全便携，可在 CleanSweep.exe 同目录放一个空文件 portable.flag，数据会改存到 exe 旁边的 CleanSweepData 文件夹。"
                               Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="关于净界" Style="{StaticResource H3}" />
                    <TextBlock Text="净界是一个只做“有依据的清理”的 Windows 工具。扫描阶段只读；清理前必须人工确认；重复文件默认进回收站；注册表项删除前先导出 .reg 备份。"
                               Style="{StaticResource Body}" Margin="0,4,0,10" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="规则设计参考：BleachBit 的清理分类思路、Microsoft 关于磁盘清理 / Windows.old / 传递优化的公开文档，以及 SHA-256 内容比对。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
