<UserControl x:Class="CleanSweep.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="980">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,22">
            <!-- Category summary -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="本分类共" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding CurrentCategorySummary.CountText}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="5,0,0,0" />
                    <TextBlock Text="·" Foreground="{StaticResource FaintBrush}" Margin="7,0" />
                    <TextBlock Text="{Binding CurrentCategorySummary.SizeText}" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="{Binding CurrentCategoryAccent, Converter={StaticResource HexBrush}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="按风险与体积排序" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Background="{StaticResource GreenPaleBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="只清理下方列出且被勾选的项目。展开“依据”可以查看路径、时间条件或哈希证据；未勾选的内容不会被触碰。"
                               FontSize="11.5" Foreground="{StaticResource GreenDarkBrush}" TextWrapping="Wrap"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding CurrentItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="15,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsSelectable}" VerticalAlignment="Top"
                                          Margin="0,4,0,0" />
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="11"
                                        Background="{StaticResource GreenSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Foreground="{StaticResource GreenDarkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" Margin="12,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="540" />
                                        <Border Style="{StaticResource ChipBorder}" Margin="8,0,0,0"
                                                Background="{Binding Risk, Converter={StaticResource RiskSoftBrush}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource ChipText}"
                                                       Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Margin="4,0,0,0"
                                                Visibility="{Binding AdminText, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="需管理员" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource AmberBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Caption}"
                                               FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayPath}" Margin="0,4,0,0" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}"
                                                Visibility="{Binding AgeText, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding AgeText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}">
                                            <TextBlock Text="{Binding MethodText}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ToggleButton Style="{StaticResource DetailsToggle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="10" Padding="14,12" Margin="0,13,0,0"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="删除依据" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Basis}" Style="{StaticResource Body}" />
                                        <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}"
                                                                 VerticalAlignment="Top" Margin="0,7,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Muted}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                                                Visibility="{Binding PathPreview, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock Text="{Binding PathPreview}" Style="{StaticResource Mono}"
                                                       MaxHeight="120" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding PathCountText}"
                                                    Command="{Binding DataContext.ShowPathsCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding PathCountText, Converter={StaticResource StringToVisibility}}" />
                                            <Button Style="{StaticResource LinkButton}" Content="在资源管理器中查看"
                                                    Command="{Binding DataContext.OpenItemLocationCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="40,45" Margin="0,0,0,10"
                    Visibility="{Binding CurrentItemsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource GreenPaleBrush}">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="这一类暂时没有可清理项目" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="可以重新扫描，或调整设置中的时间阈值后再试。"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="重新扫描" Command="{Binding ScanCommand}"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Height="34" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
