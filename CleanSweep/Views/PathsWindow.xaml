<Window x:Class="CleanSweep.Views.PathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="项目清单"
        Width="800" Height="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="18" BorderBrush="#DFE9E3" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#17342A" BlurRadius="30" ShadowDepth="8" Opacity="0.18" />
        </Border.Effect>
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,20,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SubHeader}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowButton}" Width="34" Height="34"
                        Click="Close_Click" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Margin="24,16,24,0"
                    Padding="8">
                <ListBox ItemsSource="{Binding Paths}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource Ink2Brush}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,16,0,0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="复制全部路径" Click="Copy_Click"
                                Height="36" MinWidth="108" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="关闭" Click="Close_Click"
                                Height="36" MinWidth="82" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
