<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>CleanSweep</AssemblyName>
    <RootNamespace>CleanSweep</RootNamespace>
    <ApplicationIcon>Assets\CleanSweep.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>净界 CleanSweep</Product>
    <AssemblyTitle>净界 CleanSweep</AssemblyTitle>
    <Description>可解释、可追溯的 Windows 清理工具</Description>
    <Company>CleanSweep</Company>
    <Copyright>Copyright © 2026 CleanSweep</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
